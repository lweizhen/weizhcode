    "find_files": "\u6309 glob \u9012\u5f52\u627e\u6587\u4ef6\uff0c\u9ed8\u8ba4\u9075\u5faa .gitignore \u4e14\u8df3\u8fc7\u9690\u85cf\u9879\uff0c\u7ed3\u679c\u4e3a\u7edd\u5bf9\u8def\u5f84\u3002",
    "search_content": "\u641c\u7d22 UTF-8 \u6587\u4ef6\u5185\u5bb9\uff0c\u9ed8\u8ba4\u533a\u5206\u5927\u5c0f\u5199\u7684\u666e\u901a\u6587\u672c\uff0c\u53ef\u663e\u5f0f\u542f\u7528\u6b63\u5219\u3002\u8fd4\u56de\u6587\u4ef6/\u884c/\u5185\u5bb9\u3002",
    "AskUserQuestion": "\u4ec5\u8ba1\u5212\u6a21\u5f0f\u4f7f\u7528\uff1a\u5411\u7528\u6237\u786e\u8ba4\u5c1a\u4e0d\u660e\u786e\u7684\u9700\u6c42\u3001\u8303\u56f4\u6216\u9a8c\u6536\u8fb9\u754c\u3002\u6bcf\u6b21\u4e00\u9898\uff0c\u53ef\u63d0\u4f9b\u5355\u9009\u9879\uff0c\u4e5f\u53ef\u81ea\u7531\u56de\u7b54\u3002"
  }
